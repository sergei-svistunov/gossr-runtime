{
  "name": "gossr-runtime",
  "version": "0.2.0",
  "description": "TypeScript runtime for GoSSR reactive bindings.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergei-svistunov/gossr-runtime.git"
  },
  "keywords": ["GoSSR", "reactive", "websocket", "runtime"],
  "files": ["dist", "src/ssr-block.css", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ssr-block.css": "./src/ssr-block.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm audit --audit-level=low"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  }
}
